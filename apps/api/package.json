{
  "name": "@kerf/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "hash-password": "node scripts/hash-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@kerf/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11"
  }
}
