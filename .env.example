# Copy to .env for local development. Never commit .env; production values live only in Vercel.
DATABASE_URL=postgres://kerf:kerf@localhost:5432/kerf
# Optional: a direct (unpooled) connection for pnpm db:migrate. Neon's Vercel integration sets it.
# DATABASE_URL_UNPOOLED=
# Output of: pnpm --filter @kerf/api hash-password
PASSWORD_HASH=
PORT=3000
